---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { SITE } from '../lib/site';

interface Props {
  /** Título da página. Sem ele, usa só o nome do site. */
  titulo?: string;
  descricao?: string;
  /** Imagem de compartilhamento. Sem ela, usa a imagem padrão do site. */
  imagem?: ImageMetadata;
  imagemAlt?: string;
  tipo?: 'website' | 'article';
  publicadoEm?: Date;
  semIndice?: boolean;
}

const {
  titulo,
  descricao = SITE.descricao,
  imagem,
  imagemAlt,
  tipo = 'website',
  publicadoEm,
  semIndice = false,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${SITE.nome}` : `${SITE.nome} · ${SITE.autor}, artista visual`;
const canonica = new URL(Astro.url.pathname, Astro.site);

let ogImagem = new URL('/og-padrao.png', Astro.site).href;
let ogAlt = 'Baze Labs. Digital art research engine by Emanuel Eidt.';
let ogLargura = 1200;
let ogAltura = 630;
if (imagem) {
  const otimizada = await getImage({ src: imagem, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  ogImagem = new URL(otimizada.src, Astro.site).href;
  ogAlt = imagemAlt ?? ogAlt;
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {semIndice && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.autor} />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Baze Labs · Pesquisa" href={new URL('/rss.xml', Astro.site)} />

    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={titulo ?? tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content={String(ogLargura)} />
    <meta property="og:image:height" content={String(ogAltura)} />
    <meta property="og:image:alt" content={ogAlt} />
    {publicadoEm && <meta property="article:published_time" content={publicadoEm.toISOString()} />}
    {tipo === 'article' && <meta property="article:author" content={SITE.autor} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo ?? tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImagem} />
    <meta name="twitter:image:alt" content={ogAlt} />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
