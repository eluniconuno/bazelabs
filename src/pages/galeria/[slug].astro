---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import Vizinhos from '../../components/Vizinhos.astro';
import { dominio, trabalhos, type Trabalho } from '../../lib/site';

export async function getStaticPaths() {
  const lista = await trabalhos();
  return lista.map((trabalho, i) => ({
    params: { slug: trabalho.id },
    props: { trabalho, proximo: lista[i - 1], anterior: lista[i + 1] },
  }));
}

interface Props {
  trabalho: Trabalho;
  anterior?: Trabalho;
  proximo?: Trabalho;
}

const { trabalho, anterior, proximo } = Astro.props;
const { titulo, ano, midia, imagens, video, audio, link } = trabalho.data;
const { Content } = await render(trabalho);

const [principal, ...demais] = imagens;
const temVideo = video && video.discriminant !== 'nenhum';
const resumo = `${titulo}, ${ano}. ${midia}. Trabalho de Emanuel Eidt.`;

const vizinho = (t?: Trabalho) => t && { href: `/galeria/${t.id}/`, titulo: t.data.titulo, numero: t.numero };
---

<Base titulo={titulo} descricao={resumo} imagem={principal.imagem} imagemAlt={principal.alt} tipo="article">
  <article class="obra">
    <header class="obra-cabeca">
      <p class="rotulo artigo-meta">
        <a href="/galeria/">Galeria</a>
        <span>{trabalho.numero}</span>
        <span>{ano}</span>
      </p>
      <h1 class="titulo-artigo">{titulo}</h1>
    </header>

    <div class="obra-grade">
      <div class="obra-midias">
        {
          temVideo ? (
            <Video titulo={titulo} tipo={video.discriminant} valor={video.value} poster={principal.imagem} />
          ) : (
            <figure class="figura figura-principal">
              <Image
                src={principal.imagem}
                alt={principal.alt}
                widths={[640, 1024, 1600]}
                sizes="(min-width: 1100px) 66vw, 100vw"
                loading="eager"
                fetchpriority="high"
              />
              {principal.legenda && <figcaption>{principal.legenda}</figcaption>}
            </figure>
          )
        }

        {
          audio && (
            <figure class="midia midia-audio">
              <figcaption class="rotulo">Áudio</figcaption>
              <audio controls preload="metadata" src={audio}>
                <a href={audio}>Baixe o áudio</a>
              </audio>
            </figure>
          )
        }

        {
          (temVideo && video.discriminant === 'link' ? imagens : demais).map((img) => (
            <figure class="figura">
              <Image src={img.imagem} alt={img.alt} widths={[640, 1024, 1600]} sizes="(min-width: 1100px) 66vw, 100vw" />
              {img.legenda && <figcaption>{img.legenda}</figcaption>}
            </figure>
          ))
        }
      </div>

      <aside class="obra-ficha" aria-label="Ficha técnica">
        <dl class="ficha">
          <div>
            <dt class="rotulo">Entrada</dt>
            <dd>{trabalho.numero}</dd>
          </div>
          <div>
            <dt class="rotulo">Ano</dt>
            <dd>{ano}</dd>
          </div>
          <div>
            <dt class="rotulo">Mídia / técnica</dt>
            <dd>{midia}</dd>
          </div>
        </dl>
        {
          link && (
            <a class="botao" href={link} rel="noopener">
              Abrir a experiência
              <span class="rotulo">{dominio(link)}</span>
            </a>
          )
        }
        <div class="corpo corpo-obra">
          <Content />
        </div>
      </aside>
    </div>
  </article>

  <Vizinhos rotulo="Outros trabalhos" anterior={vizinho(anterior)} proximo={vizinho(proximo)} />
</Base>
