---
// Imagem dentro de textos e descrições. A legenda vem do campo "Legenda" do painel.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  title?: string;
}

const { src, alt, title } = Astro.props;
---

<figure class="figura">
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1100px) 1000px, 100vw" />
    )
  }
  {title && <figcaption>{title}</figcaption>}
</figure>
